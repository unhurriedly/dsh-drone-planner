{
  "name": "dsh-drone-planner",
  "version": "1.1.1",
  "type": "module",
  "description": "Drone frustum route lab for the Harness Web UI, with a developer mode page for theme/copy/embed config",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "page/index.html",
    "page/dev.html",
    "page/api.js",
    "check-redesign.cjs",
    "check-defaults.cjs",
    "check-dev-mode.cjs",
    "preview-redesign.png",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "preview-dev-mode.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
